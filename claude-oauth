def cmd_resolve():
    tokens, source = resolve_tokens()
    if not tokens:
        print(
            "not authenticated — run: maki auth login claude-oauth\n"
            "  (or log in via Claude Code: claude auth login)",
            file=sys.stderr,
        )
        sys.exit(1)
    print(json.dumps(build_resolved(tokens)))


def cmd_refresh():
    tokens = load_claude_code_tokens() or load_maki_tokens()
    if not tokens or not tokens.get("refresh"):
        print("no refresh token available", file=sys.stderr)
        sys.exit(1)
    try:
        tokens = do_refresh(tokens)
    except Exception as e:
        print(f"token refresh failed: {e}", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(build_resolved(tokens)))


def cmd_login():
    """
    If Claude Code already has a valid token, just mirror it into maki's store.
    Otherwise open a browser-based device/PKCE flow.
    """
    tokens = load_claude_code_tokens()
    if tokens and not is_expired(tokens):
        save_maki_tokens(tokens)
        print("Authenticated via existing Claude Code session.")
        return

    # Attempt refresh if we have a refresh token
    if tokens and tokens.get("refresh"):
        try:
            tokens = do_refresh(tokens)
            print("Authenticated via token refresh.")
            return
        except Exception as e:
            print(f"Refresh failed ({e}), falling back to browser login...", file=sys.stderr)

    # Full browser login — direct user to Claude Code's auth flow since
    # we don't know the full PKCE parameters Claude Code uses internally.
    print("No active Claude Code session found.")
    print()
    print("Please log in via Claude Code first:")
    print()
    print("  claude auth login")
    print()
    print("Then re-run: maki auth login claude-oauth")
    sys.exit(1)


def cmd_logout():
    try:
        os.remove(TOKEN_FILE)
        print("Logged out of Claude OAuth (maki store cleared).")
        print("Note: your Claude Code session is unaffected.")
    except FileNotFoundError:
        print("Not currently logged in (maki store).")


def main():
    if len(sys.argv) < 2:
        print(f"usage: {sys.argv[0]} <info|models|resolve|refresh|login|logout>", file=sys.stderr)
        sys.exit(1)

    commands = {
        "info": cmd_info,
        "models": cmd_models,
        "resolve": cmd_resolve,
        "refresh": cmd_refresh,
        "login": cmd_login,
        "logout": cmd_logout,
    }

    fn = commands.get(sys.argv[1])
    if not fn:
        print(f"unknown command: {sys.argv[1]}", file=sys.stderr)
        sys.exit(1)
    fn()


if __name__ == "__main__":
    main()
