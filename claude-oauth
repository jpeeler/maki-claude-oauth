#!/usr/bin/env python3
"""
Claude OAuth dynamic provider for maki.

Bridges Claude Code's existing SSO/OAuth session into maki — no separate
API key needed. Reads and refreshes tokens from Claude Code's credentials file.

Install:
  cp <this-file> ~/.maki/providers/claude-oauth
  chmod +x ~/.maki/providers/claude-oauth

Usage:
  maki auth login claude-oauth   # first-time: opens browser for auth
  maki -m claude-oauth/claude-opus-4-8

To route requests through a gateway (e.g. Aperture by Tailscale) instead of
hitting api.anthropic.com directly, set:
  export CLAUDE_OAUTH_BASE_URL="http://<aperture-hostname>"
Requires the upstream Anthropic provider on the gateway to be configured
in passthrough auth_mode, since the OAuth token is forwarded as-is.

Requires Python 3.8+, no external dependencies.
Tokens are read directly from ~/.claude/.credentials.json (Claude Code's store).
"""

import getpass
import json
import os
import platform
import ssl
import subprocess
import sys
import time
import urllib.request
import urllib.parse
import urllib.error

CREDENTIALS_FILE = os.path.expanduser("~/.claude/.credentials.json")
# This is the provider's OWN private refresh cache, not maki's credential store
# (maki calls `resolve` at request time and never reads this file). Keep it out
# of ~/.maki/ — that legacy tree triggers maki's data-dir migration, and
# re-creating it wedges startup with "resolve data directory: File exists".
TOKEN_FILE = os.path.expanduser("~/.config/maki/claude-oauth-token.json")

# On macOS, Claude Code stores its OAuth credentials in the login Keychain
# (a generic-password item) rather than in CREDENTIALS_FILE — that file only
# exists on Linux / headless installs. Mirror both stores so this provider
# works regardless of where the CLI actually keeps its tokens.
KEYCHAIN_SERVICE = "Claude Code-credentials"
IS_MACOS = platform.system() == "Darwin"


def _keychain_read():
    """Return the parsed credentials dict from the macOS login Keychain, or None."""
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0 or not out.stdout.strip():
        return None
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        return None


def _keychain_write(data):
    """Update the Claude Code credentials item in the macOS login Keychain."""
    account = getpass.getuser()
    subprocess.run(
        ["security", "add-generic-password", "-U",
         "-s", KEYCHAIN_SERVICE, "-a", account, "-w", json.dumps(data)],
        capture_output=True, text=True, timeout=10, check=True,
    )


def _read_claude_code_credentials():
    """Read Claude Code's raw credentials dict from whichever store it uses.

    Returns (data, store) where store is "file" or "keychain", or (None, None).
    Prefers the file (present on Linux / headless); on macOS falls back to the
    login Keychain, which is where the CLI actually stores tokens there.
    """
    try:
        with open(CREDENTIALS_FILE) as f:
            return json.load(f), "file"
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    if IS_MACOS:
        data = _keychain_read()
        if data is not None:
            return data, "keychain"
    return None, None

# Claude Code OAuth endpoints (extracted from claude CLI binary)
TOKEN_ENDPOINT = "https://platform.claude.com/v1/oauth/token"
AUTH_ENDPOINT = "https://claude.com/cai/oauth/authorize"
CALLBACK_URL = "https://platform.claude.com/oauth/code/callback"

# Claude Code's first-party client ID
CLAUDE_CODE_CLIENT_ID = os.environ.get("CLAUDE_CODE_OAUTH_CLIENT_ID", "9d1c250a-e61b-44d9-88ed-5944d1962f5e")

REFRESH_BUFFER_SECS = 300  # refresh 5 min before expiry
DEFAULT_SCOPES = ["user:inference"]


def load_claude_code_tokens():
    """Read tokens directly from Claude Code's credentials store (file or Keychain)."""
    data, _ = _read_claude_code_credentials()
    if not data:
        return None
    oauth = data.get("claudeAiOauth", {})
    if not oauth.get("accessToken"):
        return None
    return {
        "access": oauth["accessToken"],
        "refresh": oauth.get("refreshToken"),
        "expires": oauth.get("expiresAt", 0),  # milliseconds
        "scopes": oauth.get("scopes", DEFAULT_SCOPES),
        "client_id": oauth.get("clientId", CLAUDE_CODE_CLIENT_ID),
    }


def load_maki_tokens():
    """Read tokens from maki's own auth store (written by login flow)."""
    try:
        with open(TOKEN_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def save_maki_tokens(tokens):
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    tmp = TOKEN_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(tokens, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, TOKEN_FILE)


def save_claude_code_tokens(tokens):
    """Mirror a freshly-refreshed token back into Claude Code's own
    credentials file, preserving unrelated fields (subscriptionType, etc).
    Keeps both stores in sync so neither ends up holding a stale,
    already-rotated refresh token that the OAuth server will reject.
    """
    data, store = _read_claude_code_credentials()
    if not data:
        return
    oauth = data.setdefault("claudeAiOauth", {})
    oauth["accessToken"] = tokens["access"]
    if tokens.get("refresh"):
        oauth["refreshToken"] = tokens["refresh"]
    oauth["expiresAt"] = tokens["expires"]
    if store == "keychain":
        _keychain_write(data)
        return
    tmp = CREDENTIALS_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CREDENTIALS_FILE)


def now_ms():
    return int(time.time() * 1000)


def is_expired(tokens):
    return now_ms() + REFRESH_BUFFER_SECS * 1000 >= tokens.get("expires", 0)


def _ssl_context():
    """SSL context with a usable CA bundle.

    The python.org framework build on macOS ships with an empty OpenSSL cert
    dir unless "Install Certificates.command" was run, so the default context
    can verify nothing and every HTTPS call fails with CERTIFICATE_VERIFY_FAILED.
    Fall back to certifi, then to well-known system bundles (macOS ships one at
    /etc/ssl/cert.pem), so this works regardless of the Python cert setup.
    """
    ctx = ssl.create_default_context()
    if ctx.cert_store_stats().get("x509_ca", 0) > 0:
        return ctx
    try:
        import certifi
        ctx.load_verify_locations(certifi.where())
        return ctx
    except Exception:
        pass
    for path in ("/etc/ssl/cert.pem",                    # macOS, some BSDs
                 "/etc/ssl/certs/ca-certificates.crt",   # Debian/Ubuntu
                 "/etc/pki/tls/certs/ca-bundle.crt"):     # RHEL/Fedora
        try:
            ctx.load_verify_locations(path)
            return ctx
        except OSError:
            continue
    return ctx  # nothing found; let verification fail loudly as before


def post_form(url, data):
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            **OAUTH_CONTRACT_HEADERS,
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=30, context=_ssl_context()) as resp:
        return json.loads(resp.read())


def do_refresh(tokens):
    payload = {
        "grant_type": "refresh_token",
        "refresh_token": tokens["refresh"],
    }
    client_id = tokens.get("client_id")
    if client_id:
        payload["client_id"] = client_id

    resp = post_form(TOKEN_ENDPOINT, payload)
    new_tokens = {
        "access": resp["access_token"],
        "refresh": resp.get("refresh_token", tokens["refresh"]),
        "expires": now_ms() + resp.get("expires_in", 3600) * 1000,
        "scopes": tokens.get("scopes", DEFAULT_SCOPES),
        "client_id": client_id,
    }
    save_maki_tokens(new_tokens)
    try:
        save_claude_code_tokens(new_tokens)
    except OSError:
        pass  # best-effort; maki's own store is still authoritative for us
    return new_tokens


OAUTH_CONTRACT_HEADERS = {
    "User-Agent": "claude-cli/1.0.0",
    "anthropic-beta": "oauth-2025-04-20,claude-code-20250219",
}

# Override to route through a gateway/proxy (e.g. Aperture by Tailscale)
# instead of hitting Anthropic directly. Point it at your gateway's host;
# the /v1/messages path and beta query param are appended automatically.
CLAUDE_OAUTH_BASE_URL = os.environ.get("CLAUDE_OAUTH_BASE_URL", "https://api.anthropic.com")
MESSAGES_URL = f"{CLAUDE_OAUTH_BASE_URL.rstrip('/')}/v1/messages?beta=true"


def build_resolved(tokens):
    return {
        "base_url": MESSAGES_URL,
        "headers": {
            "Authorization": f"Bearer {tokens['access']}",
            **OAUTH_CONTRACT_HEADERS,
        },
    }


def resolve_tokens():
    """
    Token resolution order:
    1. Claude Code credentials file (always up to date, shared with the CLI)
    2. Maki's own auth store (written by `maki auth login claude-oauth`)
    """
    # Prefer Claude Code's store — it's kept fresh by the CLI itself
    tokens = load_claude_code_tokens()
    if tokens and not is_expired(tokens):
        return tokens, "claude_code_store"

    # Fall back to maki's own store
    maki_tokens = load_maki_tokens()
    if maki_tokens and not is_expired(maki_tokens):
        return maki_tokens, "maki_store"

    # Need a refresh — try whichever store has the more recently issued
    # refresh token first (higher "expires" implies a later refresh),
    # then fall back to the other store in case that token is stale
    # (e.g. already rotated/consumed by the other side).
    candidates = [t for t in (tokens, maki_tokens) if t and t.get("refresh")]
    candidates.sort(key=lambda t: t.get("expires", 0), reverse=True)
    # De-dupe identical refresh tokens so we don't retry the same one twice.
    seen = set()
    unique_candidates = []
    for c in candidates:
        if c["refresh"] not in seen:
            seen.add(c["refresh"])
            unique_candidates.append(c)

    last_err = None
    for source in unique_candidates:
        try:
            return do_refresh(source), "refreshed"
        except urllib.error.HTTPError as e:
            last_err = e
            continue

    if last_err:
        raise last_err
    return None, "no_tokens"


